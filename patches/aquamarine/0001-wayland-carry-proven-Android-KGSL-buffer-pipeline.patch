 CFrameRunningGuard::~CFrameRunningGuard() {
     m_s.setFrameRunning(false);
+
+    if (!m_s.m_rescheduleRequested)
+        return;
+
+    m_s.m_rescheduleRequested = false;
+
+    // Always replay the request after the running callback returns.  A render
+    // submitted from inside that callback makes m_pending true, but commit()
+    // also clears IOutput::needsFrame.  Dropping the replay merely because a
+    // host callback is pending therefore loses the damage that arrived during
+    // the render.  The output's scheduleFrame() restores needsFrame and will
+    // defer the actual emission until the pending callback completes.
+    m_s.rescheduleNeeded.emit();
 }
