diff --git a/src/output/OutputTiming.cpp b/src/output/OutputTiming.cpp
new file mode 100644
index 0000000..56f0804
--- /dev/null
+++ b/src/output/OutputTiming.cpp
@@ -0,0 +1,25 @@
+#include "OutputTiming.hpp"
+
+std::optional<std::chrono::nanoseconds> Aquamarine::OutputTiming::predictNextVBlank(std::chrono::nanoseconds lastVblank, std::chrono::nanoseconds now,
+                                                                                    std::chrono::nanoseconds refreshPeriod) {
+    if (lastVblank.count() < 0 || now.count() < 0 || refreshPeriod.count() <= 0 || lastVblank > now)
+        return std::nullopt;
+
+    if (now - lastVblank >= refreshPeriod || lastVblank > std::chrono::nanoseconds::max() - refreshPeriod)
+        return std::nullopt;
+
+    return lastVblank + refreshPeriod;
+}
+
+std::optional<std::chrono::steady_clock::time_point> Aquamarine::OutputTiming::toSteadyClock(std::chrono::nanoseconds target, std::chrono::nanoseconds monotonicNow,
+                                                                                             std::chrono::steady_clock::time_point steadyBefore,
+                                                                                             std::chrono::steady_clock::time_point steadyAfter) {
+    if (steadyAfter < steadyBefore || target <= monotonicNow)
+        return std::nullopt;
+
+    const auto RESULT = steadyBefore + (steadyAfter - steadyBefore) / 2 + (target - monotonicNow);
+    if (RESULT <= steadyAfter)
+        return std::nullopt;
+
+    return RESULT;
+}
diff --git a/tests/KGSLDMAHeapRenderProbe.cpp b/tests/KGSLDMAHeapRenderProbe.cpp
new file mode 100644
index 0000000..e2a5b9e
--- /dev/null
+++ b/tests/KGSLDMAHeapRenderProbe.cpp
@@ -0,0 +1,147 @@
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-heap.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+
+static void dumpPixels(const char* label, const unsigned char* pixels, size_t length) {
+    size_t nonzero = 0;
+    unsigned long long sum = 0;
+    for (size_t i = 0; i < length; ++i) {
+        nonzero += pixels[i] != 0;
+        sum += pixels[i];
+    }
+    std::printf("%s nonzero=%zu/%zu sum=%llu first=%02x,%02x,%02x,%02x\n", label, nonzero, length, sum, pixels[0], pixels[1], pixels[2], pixels[3]);
+}
+
+int main(int argc, char** argv) {
+    constexpr int width = 64, height = 64, stride = width * 4;
+    constexpr size_t length = stride * height;
+    const bool withModifier = argc > 1 && std::strcmp(argv[1], "modifier") == 0;
+
+    int heap = open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+    if (heap < 0) {
+        std::fprintf(stderr, "open heap: %s\n", std::strerror(errno));
+        return 1;
+    }
+    dma_heap_allocation_data allocation{.len = length, .fd = 0, .fd_flags = O_RDWR | O_CLOEXEC, .heap_flags = 0};
+    if (ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &allocation) < 0) {
+        std::fprintf(stderr, "allocate: %s\n", std::strerror(errno));
+        return 1;
+    }
+    close(heap);
+    const int fd = static_cast<int>(allocation.fd);
+
+    dma_buf_sync sync{.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_RW};
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    auto* mapped = static_cast<unsigned char*>(mmap(nullptr, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0));
+    if (mapped == MAP_FAILED) {
+        std::fprintf(stderr, "mmap: %s\n", std::strerror(errno));
+        return 1;
+    }
+    std::memset(mapped, 0, length);
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_RW;
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    munmap(mapped, length);
+
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    auto imageToRenderbuffer = reinterpret_cast<PFNGLEGLIMAGETARGETRENDERBUFFERSTORAGEOESPROC>(eglGetProcAddress("glEGLImageTargetRenderbufferStorageOES"));
+    if (!getPlatformDisplay || !createImage || !destroyImage || !imageToRenderbuffer) {
+        std::fprintf(stderr, "required EGL/GL extension entrypoint missing\n");
+        return 1;
+    }
+
+    EGLDisplay display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    EGLint major = 0, minor = 0;
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, &major, &minor)) {
+        std::fprintf(stderr, "eglInitialize: 0x%x\n", eglGetError());
+        return 1;
+    }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint contextAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT || !eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) {
+        std::fprintf(stderr, "create/make context: 0x%x\n", eglGetError());
+        return 1;
+    }
+
+    EGLint attrs[24] = {
+        EGL_WIDTH, width,
+        EGL_HEIGHT, height,
+        EGL_LINUX_DRM_FOURCC_EXT, static_cast<EGLint>(DRM_FORMAT_XRGB8888),
+        EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, stride,
+    };
+    int attr = 12;
+    if (withModifier) {
+        attrs[attr++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT;
+        attrs[attr++] = 0;
+        attrs[attr++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT;
+        attrs[attr++] = 0;
+    }
+    attrs[attr++] = EGL_IMAGE_PRESERVED_KHR;
+    attrs[attr++] = EGL_TRUE;
+    attrs[attr++] = EGL_NONE;
+
+    EGLImageKHR image = createImage(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+    if (image == EGL_NO_IMAGE_KHR) {
+        std::fprintf(stderr, "eglCreateImageKHR: 0x%x\n", eglGetError());
+        return 1;
+    }
+    GLuint rbo = 0, fbo = 0;
+    glGenRenderbuffers(1, &rbo);
+    glBindRenderbuffer(GL_RENDERBUFFER, rbo);
+    imageToRenderbuffer(GL_RENDERBUFFER, image);
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, rbo);
+    const GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    std::printf("egl=%d.%d modifier=%d framebuffer=0x%x gl_error=0x%x\n", major, minor, withModifier, status, glGetError());
+    if (status != GL_FRAMEBUFFER_COMPLETE)
+        return 1;
+
+    glViewport(0, 0, width, height);
+    glDisable(GL_SCISSOR_TEST);
+    glClearColor(1.0f, 0.25f, 0.5f, 1.0f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glFinish();
+    unsigned char gpuPixels[4 * 4 * 4] = {};
+    glReadPixels(0, 0, 4, 4, GL_RGBA, GL_UNSIGNED_BYTE, gpuPixels);
+    std::printf("post-render gl_error=0x%x\n", glGetError());
+    dumpPixels("gpu-readback", gpuPixels, sizeof(gpuPixels));
+
+    sync.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ;
+    const int syncStart = ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    mapped = static_cast<unsigned char*>(mmap(nullptr, length, PROT_READ, MAP_SHARED, fd, 0));
+    if (mapped == MAP_FAILED) {
+        std::fprintf(stderr, "post-render mmap: %s\n", std::strerror(errno));
+        return 1;
+    }
+    std::printf("cpu-sync=%d errno=%d ", syncStart, syncStart < 0 ? errno : 0);
+    dumpPixels("cpu-map", mapped, length);
+    munmap(mapped, length);
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+    ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+
+    glDeleteFramebuffers(1, &fbo);
+    glDeleteRenderbuffers(1, &rbo);
+    destroyImage(display, image);
+    eglDestroyContext(display, context);
+    eglTerminate(display);
+    close(fd);
+    return 0;
+}
diff --git a/tests/KGSLGBMProbe.cpp b/tests/KGSLGBMProbe.cpp
new file mode 100644
index 0000000..4fdff0c
--- /dev/null
+++ b/tests/KGSLGBMProbe.cpp
@@ -0,0 +1,45 @@
+#include <fcntl.h>
+#include <gbm.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+
+int main() {
+    const int fd = open("/dev/kgsl-3d0", O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        std::fprintf(stderr, "open: %s\n", std::strerror(errno));
+        return 1;
+    }
+
+    gbm_device* device = gbm_create_device(fd);
+    if (!device) {
+        std::fprintf(stderr, "gbm_create_device failed: %s\n", std::strerror(errno));
+        close(fd);
+        return 2;
+    }
+
+    std::printf("backend=%s format_xrgb=%d format_argb=%d\n", gbm_device_get_backend_name(device),
+                gbm_device_is_format_supported(device, GBM_FORMAT_XRGB8888, GBM_BO_USE_RENDERING),
+                gbm_device_is_format_supported(device, GBM_FORMAT_ARGB8888, GBM_BO_USE_RENDERING));
+
+    gbm_bo* bo = gbm_bo_create(device, 256, 256, GBM_FORMAT_ARGB8888,
+                               GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+    if (!bo) {
+        std::fprintf(stderr, "gbm_bo_create failed: %s\n", std::strerror(errno));
+        gbm_device_destroy(device);
+        close(fd);
+        return 3;
+    }
+
+    const int dmafd = gbm_bo_get_fd(bo);
+    std::printf("bo=%p stride=%u modifier=0x%016llx dmafd=%d\n", static_cast<void*>(bo),
+                gbm_bo_get_stride(bo), static_cast<unsigned long long>(gbm_bo_get_modifier(bo)), dmafd);
+    if (dmafd >= 0)
+        close(dmafd);
+    gbm_bo_destroy(bo);
+    gbm_device_destroy(device);
+    close(fd);
+    return 0;
+}
