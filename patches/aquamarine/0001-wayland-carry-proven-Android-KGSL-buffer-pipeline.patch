diff --git a/include/aquamarine/allocator/Vulkan.hpp b/include/aquamarine/allocator/Vulkan.hpp
new file mode 100644
index 0000000..18c447a
--- /dev/null
+++ b/include/aquamarine/allocator/Vulkan.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "Allocator.hpp"
+
+#include <vulkan/vulkan.h>
+
+namespace Aquamarine {
+    class CVulkanAllocator;
+    class CBackend;
+    class CSwapchain;
+
+    class CVulkanBuffer : public IBuffer {
+      public:
+        virtual ~CVulkanBuffer();
+
+        virtual eBufferCapability caps();
+        virtual eBufferType       type();
+        virtual void              update(const Hyprutils::Math::CRegion& damage);
+        virtual bool              isSynchronous();
+        virtual bool              good();
+        virtual SDMABUFAttrs      dmabuf();
+
+      private:
+        CVulkanBuffer(const SAllocatorBufferParams& params, Hyprutils::Memory::CWeakPointer<CVulkanAllocator> allocator_);
+
+        Hyprutils::Memory::CWeakPointer<CVulkanAllocator> allocator;
+        VkImage                                          image  = VK_NULL_HANDLE;
+        VkDeviceMemory                                   memory = VK_NULL_HANDLE;
+        SDMABUFAttrs                                     attrs{.success = false};
+
+        friend class CVulkanAllocator;
+    };
+
+    // Turnip knows the memory/layout constraints for an Adreno color image.
+    // Allocate through Vulkan, then export the image's dedicated memory as a
+    // linear DMA-BUF which both Hyprland EGL and the parent Weston can import.
+    class CVulkanAllocator : public IAllocator {
+      public:
+        ~CVulkanAllocator();
+        static Hyprutils::Memory::CSharedPointer<CVulkanAllocator> create(Hyprutils::Memory::CWeakPointer<CBackend> backend_);
+
+        virtual Hyprutils::Memory::CSharedPointer<IBuffer> acquire(const SAllocatorBufferParams& params,
+                                                                   Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain_);
+        virtual Hyprutils::Memory::CSharedPointer<CBackend> getBackend();
+        virtual int                                         drmFD();
+        virtual eAllocatorType                              type();
+
+        Hyprutils::Memory::CWeakPointer<CVulkanAllocator> self;
+
+      private:
+        CVulkanAllocator(Hyprutils::Memory::CWeakPointer<CBackend> backend_);
+        bool init();
+
+        Hyprutils::Memory::CWeakPointer<CBackend> backend;
+        VkInstance                               instance = VK_NULL_HANDLE;
+        VkPhysicalDevice                         physical = VK_NULL_HANDLE;
+        VkDevice                                 device   = VK_NULL_HANDLE;
+        uint32_t                                 queueFamily = UINT32_MAX;
+        PFN_vkGetMemoryFdKHR                     getMemoryFd = nullptr;
+
+        friend class CVulkanBuffer;
+    };
+}
