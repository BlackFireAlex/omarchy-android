+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstring>
+
+static void dump(const char* label, const unsigned char* p, size_t n) {
+    size_t nonzero = 0;
+    unsigned long long sum = 0;
+    for (size_t i = 0; i < n; ++i) { nonzero += p[i] != 0; sum += p[i]; }
+    std::printf("%s nonzero=%zu/%zu sum=%llu first=%02x,%02x,%02x,%02x\n", label, nonzero, n, sum, p[0], p[1], p[2], p[3]);
+}
+
+int main() {
+    constexpr int width = 64, height = 64;
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    auto queryExport = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC>(eglGetProcAddress("eglExportDMABUFImageQueryMESA"));
+    auto exportImage = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEMESAPROC>(eglGetProcAddress("eglExportDMABUFImageMESA"));
+    EGLDisplay display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    EGLint major = 0, minor = 0;
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, &major, &minor)) { std::fprintf(stderr, "eglInitialize: 0x%x\n", eglGetError()); return 1; }
+    const char* extensions = eglQueryString(display, EGL_EXTENSIONS);
+    std::printf("egl=%d.%d export_ext=%d texture_image_ext=%d\n", major, minor,
+        extensions && std::strstr(extensions, "EGL_MESA_image_dma_buf_export"),
+        extensions && std::strstr(extensions, "EGL_KHR_gl_texture_2D_image"));
+    if (!createImage || !destroyImage || !queryExport || !exportImage) { std::fprintf(stderr, "export entrypoint missing\n"); return 1; }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint contextAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT || !eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) { std::fprintf(stderr, "context: 0x%x\n", eglGetError()); return 1; }
+
+    GLuint texture = 0, fbo = 0;
+    glGenTextures(1, &texture); glBindTexture(GL_TEXTURE_2D, texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo); glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    std::printf("framebuffer=0x%x gl_error=0x%x\n", glCheckFramebufferStatus(GL_FRAMEBUFFER), glGetError());
+    glViewport(0, 0, width, height); glClearColor(1.0f, 0.25f, 0.5f, 1.0f); glClear(GL_COLOR_BUFFER_BIT); glFinish();
+    unsigned char pixels[64] = {}; glReadPixels(0, 0, 4, 4, GL_RGBA, GL_UNSIGNED_BYTE, pixels); dump("gpu-readback", pixels, sizeof(pixels));
+
+    const EGLint imageAttrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    EGLImageKHR image = createImage(display, context, EGL_GL_TEXTURE_2D_KHR, reinterpret_cast<EGLClientBuffer>(static_cast<uintptr_t>(texture)), imageAttrs);
+    if (image == EGL_NO_IMAGE_KHR) { std::fprintf(stderr, "texture eglCreateImageKHR: 0x%x\n", eglGetError()); return 1; }
+    int fourcc = 0, planes = 0;
+    EGLuint64KHR modifier = DRM_FORMAT_MOD_INVALID;
+    if (!queryExport(display, image, &fourcc, &planes, &modifier)) { std::fprintf(stderr, "query export: 0x%x\n", eglGetError()); return 1; }
+    int fds[4] = {-1, -1, -1, -1}; EGLint strides[4] = {}; EGLint offsets[4] = {};
+    if (!exportImage(display, image, fds, strides, offsets)) { std::fprintf(stderr, "export: 0x%x\n", eglGetError()); return 1; }
+    std::printf("export fourcc=0x%x planes=%d modifier=0x%llx fd=%d stride=%d offset=%d\n", fourcc, planes,
+        (unsigned long long)modifier, fds[0], strides[0], offsets[0]);
+
+    const size_t length = static_cast<size_t>(offsets[0]) + static_cast<size_t>(strides[0]) * height;
+    dma_buf_sync sync{.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ};
+    int syncResult = ioctl(fds[0], DMA_BUF_IOCTL_SYNC, &sync);
+    auto* mapped = static_cast<unsigned char*>(mmap(nullptr, length, PROT_READ, MAP_SHARED, fds[0], 0));
+    std::printf("cpu-map=%p sync=%d ", mapped, syncResult);
+    if (mapped != MAP_FAILED) { dump("cpu-visible", mapped + offsets[0], static_cast<size_t>(strides[0]) * height); munmap(mapped, length); }
+    else std::printf("mmap-failed\n");
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ; ioctl(fds[0], DMA_BUF_IOCTL_SYNC, &sync);
+
+    for (int i = 0; i < planes; ++i) if (fds[i] >= 0) close(fds[i]);
+    destroyImage(display, image); glDeleteFramebuffers(1, &fbo); glDeleteTextures(1, &texture);
+    eglDestroyContext(display, context); eglTerminate(display);
+    return 0;
+}
diff --git a/tests/KGSLGLExportWaylandProbe.cpp b/tests/KGSLGLExportWaylandProbe.cpp
new file mode 100644
index 0000000..da1947f
--- /dev/null
+++ b/tests/KGSLGLExportWaylandProbe.cpp
@@ -0,0 +1,119 @@
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <wayland-client.h>
+#include "linux-dmabuf-client.h"
+#include "xdg-shell-client.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unistd.h>
+
+struct State {
+    wl_display* display = nullptr;
+    wl_compositor* compositor = nullptr;
+    xdg_wm_base* wmBase = nullptr;
+    zwp_linux_dmabuf_v1* dmabuf = nullptr;
+    wl_surface* surface = nullptr;
+    xdg_surface* xdgSurface = nullptr;
+    xdg_toplevel* toplevel = nullptr;
+    wl_buffer* buffer = nullptr;
+    bool configured = false;
+};
+
+static void registryGlobal(void* data, wl_registry* registry, uint32_t name, const char* interface, uint32_t version) {
+    auto* s = static_cast<State*>(data);
+    if (std::strcmp(interface, wl_compositor_interface.name) == 0)
+        s->compositor = static_cast<wl_compositor*>(wl_registry_bind(registry, name, &wl_compositor_interface, version < 5 ? version : 5));
+    else if (std::strcmp(interface, xdg_wm_base_interface.name) == 0)
+        s->wmBase = static_cast<xdg_wm_base*>(wl_registry_bind(registry, name, &xdg_wm_base_interface, version < 5 ? version : 5));
+    else if (std::strcmp(interface, zwp_linux_dmabuf_v1_interface.name) == 0)
+        s->dmabuf = static_cast<zwp_linux_dmabuf_v1*>(wl_registry_bind(registry, name, &zwp_linux_dmabuf_v1_interface, version < 3 ? version : 3));
+}
+static void registryRemove(void*, wl_registry*, uint32_t) {}
+static const wl_registry_listener registryListener = {registryGlobal, registryRemove};
+static void ping(void*, xdg_wm_base* base, uint32_t serial) { xdg_wm_base_pong(base, serial); }
+static const xdg_wm_base_listener wmListener = {ping};
+static void configure(void* data, xdg_surface* surface, uint32_t serial) {
+    auto* s = static_cast<State*>(data);
+    xdg_surface_ack_configure(surface, serial);
+    s->configured = true;
+    if (s->buffer) {
+        wl_surface_attach(s->surface, s->buffer, 0, 0);
+        wl_surface_damage_buffer(s->surface, 0, 0, INT32_MAX, INT32_MAX);
+        wl_surface_commit(s->surface);
+    }
+}
+static const xdg_surface_listener xdgSurfaceListener = {configure};
+static void topConfigure(void*, xdg_toplevel*, int32_t, int32_t, wl_array*) {}
+static void topClose(void*, xdg_toplevel*) {}
+static void topBounds(void*, xdg_toplevel*, int32_t, int32_t) {}
+static void topCapabilities(void*, xdg_toplevel*, wl_array*) {}
+static const xdg_toplevel_listener topListener = {topConfigure, topClose, topBounds, topCapabilities};
+
+int main() {
+    constexpr int width = 1920, height = 1449;
+    State state;
+    state.display = wl_display_connect(nullptr);
+    if (!state.display) { std::fprintf(stderr, "wl_display_connect failed\n"); return 1; }
+    wl_registry* registry = wl_display_get_registry(state.display);
+    wl_registry_add_listener(registry, &registryListener, &state);
+    wl_display_roundtrip(state.display);
+    if (!state.compositor || !state.wmBase || !state.dmabuf) { std::fprintf(stderr, "missing Wayland globals\n"); return 1; }
+    xdg_wm_base_add_listener(state.wmBase, &wmListener, &state);
+
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto queryExport = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC>(eglGetProcAddress("eglExportDMABUFImageQueryMESA"));
+    auto exportImage = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEMESAPROC>(eglGetProcAddress("eglExportDMABUFImageMESA"));
+    EGLDisplay eglDisplay = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    EGLint major = 0, minor = 0;
+    if (eglDisplay == EGL_NO_DISPLAY || !eglInitialize(eglDisplay, &major, &minor)) { std::fprintf(stderr, "eglInitialize: 0x%x\n", eglGetError()); return 1; }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint contextAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    EGLContext context = eglCreateContext(eglDisplay, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT || !eglMakeCurrent(eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) { std::fprintf(stderr, "context: 0x%x\n", eglGetError()); return 1; }
+
+    GLuint texture = 0, fbo = 0;
+    glGenTextures(1, &texture); glBindTexture(GL_TEXTURE_2D, texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo); glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) { std::fprintf(stderr, "framebuffer incomplete\n"); return 1; }
+    glViewport(0, 0, width, height);
+    glClearColor(0.8f, 0.05f, 0.35f, 1.0f); glClear(GL_COLOR_BUFFER_BIT);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(width / 4, height / 4, width / 2, height / 2);
+    glClearColor(0.05f, 0.8f, 0.3f, 1.0f); glClear(GL_COLOR_BUFFER_BIT);
+    glDisable(GL_SCISSOR_TEST); glFinish();
+
+    const EGLint imageAttrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    EGLImageKHR image = createImage(eglDisplay, context, EGL_GL_TEXTURE_2D_KHR, reinterpret_cast<EGLClientBuffer>(static_cast<uintptr_t>(texture)), imageAttrs);
+    if (image == EGL_NO_IMAGE_KHR) { std::fprintf(stderr, "eglCreateImage: 0x%x\n", eglGetError()); return 1; }
+    int fourcc = 0, planes = 0; EGLuint64KHR modifier = DRM_FORMAT_MOD_INVALID;
+    if (!queryExport(eglDisplay, image, &fourcc, &planes, &modifier) || planes != 1) { std::fprintf(stderr, "query export: 0x%x planes=%d\n", eglGetError(), planes); return 1; }
+    int fds[4] = {-1, -1, -1, -1}; EGLint strides[4] = {}, offsets[4] = {};
+    if (!exportImage(eglDisplay, image, fds, strides, offsets)) { std::fprintf(stderr, "export: 0x%x\n", eglGetError()); return 1; }
+    std::printf("export fourcc=0x%x modifier=0x%llx stride=%d offset=%d\n", fourcc, (unsigned long long)modifier, strides[0], offsets[0]);
+
+    zwp_linux_buffer_params_v1* params = zwp_linux_dmabuf_v1_create_params(state.dmabuf);
+    zwp_linux_buffer_params_v1_add(params, fds[0], 0, offsets[0], strides[0], static_cast<uint32_t>(modifier >> 32), static_cast<uint32_t>(modifier));
+    state.buffer = zwp_linux_buffer_params_v1_create_immed(params, width, height, static_cast<uint32_t>(fourcc), 0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    state.surface = wl_compositor_create_surface(state.compositor);
+    state.xdgSurface = xdg_wm_base_get_xdg_surface(state.wmBase, state.surface);
+    xdg_surface_add_listener(state.xdgSurface, &xdgSurfaceListener, &state);
+    state.toplevel = xdg_surface_get_toplevel(state.xdgSurface);
+    xdg_toplevel_add_listener(state.toplevel, &topListener, &state);
+    xdg_toplevel_set_title(state.toplevel, "KGSL zero-copy export probe");
+    xdg_toplevel_set_fullscreen(state.toplevel, nullptr);
+    wl_surface_commit(state.surface);
+    wl_display_flush(state.display);
+    for (int i = 0; i < 500 && wl_display_dispatch(state.display) >= 0; ++i) {
+        if (state.configured && i > 100) break;
+    }
+    sleep(8);
+    return 0;
+}
diff --git a/tests/KGSLGLFormatExportProbe.cpp b/tests/KGSLGLFormatExportProbe.cpp
new file mode 100644
index 0000000..cf3f5d2
--- /dev/null
+++ b/tests/KGSLGLFormatExportProbe.cpp
@@ -0,0 +1,80 @@
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <hyprgraphics/egl/Egl.hpp>
+
+#include <array>
+#include <cstdlib>
+#include <cstdio>
+#include <cstdint>
+#include <unistd.h>
+
+using namespace Hyprgraphics::Egl;
+
+int main(int argc, char** argv) {
+    const int width  = argc > 1 ? std::atoi(argv[1]) : 1448;
+    const int height = argc > 2 ? std::atoi(argv[2]) : 1920;
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto createImage        = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto destroyImage       = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    auto queryExport        = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEQUERYMESAPROC>(eglGetProcAddress("eglExportDMABUFImageQueryMESA"));
+    auto exportImage        = reinterpret_cast<PFNEGLEXPORTDMABUFIMAGEMESAPROC>(eglGetProcAddress("eglExportDMABUFImageMESA"));
+
+    EGLDisplay display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    EGLint major = 0, minor = 0;
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, &major, &minor))
+        return 1;
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint contextAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT || !eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context))
+        return 2;
+
+    constexpr std::array<uint32_t, 4> formats = {
+        DRM_FORMAT_XRGB8888, DRM_FORMAT_ARGB8888, DRM_FORMAT_XBGR8888, DRM_FORMAT_ABGR8888,
+    };
+
+    for (const auto drmFormat : formats) {
+        const auto* format = getPixelFormatFromDRM(drmFormat);
+        if (!format) {
+            std::printf("drm=0x%08x missing\n", drmFormat);
+            continue;
+        }
+
+        GLuint texture = 0;
+        glGenTextures(1, &texture);
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexImage2D(GL_TEXTURE_2D, 0, format->glInternalFormat ? format->glInternalFormat : format->glFormat,
+                     width, height, 0, format->glFormat, format->glType, nullptr);
+        const GLenum allocError = glGetError();
+
+        const EGLint imageAttrs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+        EGLImageKHR image = createImage(display, context, EGL_GL_TEXTURE_2D_KHR,
+                                        reinterpret_cast<EGLClientBuffer>(static_cast<uintptr_t>(texture)), imageAttrs);
+        int fourcc = 0, planes = 0;
+        EGLuint64KHR modifier = DRM_FORMAT_MOD_INVALID;
+        EGLBoolean queried = image != EGL_NO_IMAGE_KHR && queryExport(display, image, &fourcc, &planes, &modifier);
+        int fds[4] = {-1, -1, -1, -1};
+        EGLint strides[4] = {}, offsets[4] = {};
+        EGLBoolean exported = queried && exportImage(display, image, fds, strides, offsets);
+
+        std::printf("size=%dx%d drm=0x%08x internal=0x%x glfmt=0x%x type=0x%x allocerr=0x%x image=%d query=%d export=%d fd=%d out=0x%08x planes=%d mod=0x%016llx stride=%d eglerr=0x%x\n",
+                    width, height, drmFormat, format->glInternalFormat, format->glFormat, format->glType, allocError,
+                    image != EGL_NO_IMAGE_KHR, queried, exported, fds[0], fourcc, planes,
+                    static_cast<unsigned long long>(modifier), strides[0], eglGetError());
+
+        for (int& fd : fds)
+            if (fd >= 0)
+                close(fd);
+        if (image != EGL_NO_IMAGE_KHR)
+            destroyImage(display, image);
+        glDeleteTextures(1, &texture);
+    }
+
+    eglDestroyContext(display, context);
+    eglTerminate(display);
+    return 0;
+}
diff --git a/tests/KGSLVulkanEGLRenderProbe.cpp b/tests/KGSLVulkanEGLRenderProbe.cpp
new file mode 100644
index 0000000..d1ffb02
--- /dev/null
+++ b/tests/KGSLVulkanEGLRenderProbe.cpp
@@ -0,0 +1,151 @@
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+#include <vulkan/vulkan.h>
+#include <drm_fourcc.h>
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+#define VK_OK(call) do { VkResult r = (call); if (r != VK_SUCCESS) { std::fprintf(stderr, "%s: %d\n", #call, r); return 1; } } while (0)
+
+static void dump(const char* label, const unsigned char* p, size_t n) {
+    size_t nonzero = 0;
+    unsigned long long sum = 0;
+    for (size_t i = 0; i < n; ++i) { nonzero += p[i] != 0; sum += p[i]; }
+    std::printf("%s nonzero=%zu/%zu sum=%llu first=%02x,%02x,%02x,%02x\n", label, nonzero, n, sum, p[0], p[1], p[2], p[3]);
+}
+
+int main(int argc, char** argv) {
+    constexpr uint32_t width = 64, height = 64;
+    const bool withModifier = argc > 1 && std::strcmp(argv[1], "modifier") == 0;
+
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "kgsl-vulkan-egl-render-probe";
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    ici.pApplicationInfo = &app;
+    VkInstance instance = VK_NULL_HANDLE;
+    VK_OK(vkCreateInstance(&ici, nullptr, &instance));
+    uint32_t physicalCount = 0;
+    VK_OK(vkEnumeratePhysicalDevices(instance, &physicalCount, nullptr));
+    std::vector<VkPhysicalDevice> physicals(physicalCount);
+    VK_OK(vkEnumeratePhysicalDevices(instance, &physicalCount, physicals.data()));
+    if (physicals.empty()) return 2;
+    VkPhysicalDevice physical = physicals[0];
+    uint32_t familyCount = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, nullptr);
+    std::vector<VkQueueFamilyProperties> families(familyCount);
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, families.data());
+    uint32_t family = UINT32_MAX;
+    for (uint32_t i = 0; i < familyCount; ++i) if (families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) { family = i; break; }
+    if (family == UINT32_MAX) return 3;
+    float priority = 1.0f;
+    VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    qci.queueFamilyIndex = family; qci.queueCount = 1; qci.pQueuePriorities = &priority;
+    const char* extensions[] = {VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME};
+    VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    dci.queueCreateInfoCount = 1; dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = 1; dci.ppEnabledExtensionNames = extensions;
+    VkDevice device = VK_NULL_HANDLE;
+    VK_OK(vkCreateDevice(physical, &dci, nullptr, &device));
+
+    VkExternalMemoryImageCreateInfo external{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+    external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkImageCreateInfo imageInfo{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    imageInfo.pNext = &external;
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = VK_FORMAT_B8G8R8A8_UNORM;
+    imageInfo.extent = {width, height, 1};
+    imageInfo.mipLevels = 1; imageInfo.arrayLayers = 1; imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_LINEAR;
+    imageInfo.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImage vkImage = VK_NULL_HANDLE;
+    VK_OK(vkCreateImage(device, &imageInfo, nullptr, &vkImage));
+    VkMemoryRequirements requirements{};
+    vkGetImageMemoryRequirements(device, vkImage, &requirements);
+    VkPhysicalDeviceMemoryProperties memoryProperties{};
+    vkGetPhysicalDeviceMemoryProperties(physical, &memoryProperties);
+    uint32_t memoryType = UINT32_MAX;
+    for (uint32_t i = 0; i < memoryProperties.memoryTypeCount; ++i)
+        if ((requirements.memoryTypeBits & (1U << i)) && (memoryProperties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) { memoryType = i; break; }
+    if (memoryType == UINT32_MAX) for (uint32_t i = 0; i < memoryProperties.memoryTypeCount; ++i)
+        if (requirements.memoryTypeBits & (1U << i)) { memoryType = i; break; }
+    if (memoryType == UINT32_MAX) return 4;
+    VkMemoryDedicatedAllocateInfo dedicated{VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO}; dedicated.image = vkImage;
+    VkExportMemoryAllocateInfo exportInfo{VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+    exportInfo.pNext = &dedicated; exportInfo.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocation.pNext = &exportInfo; allocation.allocationSize = requirements.size; allocation.memoryTypeIndex = memoryType;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VK_OK(vkAllocateMemory(device, &allocation, nullptr, &memory));
+    VK_OK(vkBindImageMemory(device, vkImage, memory, 0));
+    VkImageSubresource subresource{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0};
+    VkSubresourceLayout layout{};
+    vkGetImageSubresourceLayout(device, vkImage, &subresource, &layout);
+    auto getMemoryFd = reinterpret_cast<PFN_vkGetMemoryFdKHR>(vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR"));
+    VkMemoryGetFdInfoKHR fdInfo{VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR};
+    fdInfo.memory = memory; fdInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    int fd = -1;
+    VK_OK(getMemoryFd(device, &fdInfo, &fd));
+    std::printf("vulkan allocation=%llu offset=%llu rowPitch=%llu fd=%d\n",
+        (unsigned long long)requirements.size, (unsigned long long)layout.offset, (unsigned long long)layout.rowPitch, fd);
+
+    auto getPlatformDisplay = reinterpret_cast<PFNEGLGETPLATFORMDISPLAYEXTPROC>(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    auto createImage = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+    auto destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    auto imageToRenderbuffer = reinterpret_cast<PFNGLEGLIMAGETARGETRENDERBUFFERSTORAGEOESPROC>(eglGetProcAddress("glEGLImageTargetRenderbufferStorageOES"));
+    EGLDisplay display = getPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    EGLint major = 0, minor = 0;
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, &major, &minor)) { std::fprintf(stderr, "eglInitialize: 0x%x\n", eglGetError()); return 1; }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint contextAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_NONE};
+    EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, contextAttrs);
+    if (context == EGL_NO_CONTEXT || !eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) { std::fprintf(stderr, "context: 0x%x\n", eglGetError()); return 1; }
+    EGLint attrs[24] = {
+        EGL_WIDTH, (EGLint)width, EGL_HEIGHT, (EGLint)height,
+        EGL_LINUX_DRM_FOURCC_EXT, (EGLint)DRM_FORMAT_XRGB8888,
+        EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, (EGLint)layout.offset,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, (EGLint)layout.rowPitch,
+    };
+    int attr = 12;
+    if (withModifier) {
+        attrs[attr++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT; attrs[attr++] = 0;
+        attrs[attr++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT; attrs[attr++] = 0;
+    }
+    attrs[attr++] = EGL_IMAGE_PRESERVED_KHR; attrs[attr++] = EGL_TRUE; attrs[attr++] = EGL_NONE;
+    EGLImageKHR eglImage = createImage(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+    if (eglImage == EGL_NO_IMAGE_KHR) { std::fprintf(stderr, "eglCreateImageKHR: 0x%x\n", eglGetError()); return 1; }
+    GLuint rbo = 0, fbo = 0;
+    glGenRenderbuffers(1, &rbo); glBindRenderbuffer(GL_RENDERBUFFER, rbo); imageToRenderbuffer(GL_RENDERBUFFER, eglImage);
+    glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo); glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, rbo);
+    GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    std::printf("egl=%d.%d modifier=%d framebuffer=0x%x gl_error=0x%x\n", major, minor, withModifier, status, glGetError());
+    if (status != GL_FRAMEBUFFER_COMPLETE) return 1;
+    glViewport(0, 0, width, height); glClearColor(1.0f, 0.25f, 0.5f, 1.0f); glClear(GL_COLOR_BUFFER_BIT); glFinish();
+    unsigned char pixels[64] = {};
+    glReadPixels(0, 0, 4, 4, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    std::printf("post-render gl_error=0x%x\n", glGetError()); dump("gpu-readback", pixels, sizeof(pixels));
+
+    dma_buf_sync sync{.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ};
+    int syncResult = ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+    auto* mapped = static_cast<unsigned char*>(mmap(nullptr, requirements.size, PROT_READ, MAP_SHARED, fd, 0));
+    std::printf("cpu-map=%p sync=%d ", mapped, syncResult);
+    if (mapped != MAP_FAILED) { dump("cpu-visible", mapped, requirements.size); munmap(mapped, requirements.size); }
+    else std::printf("mmap-failed\n");
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ; ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync);
+
+    glDeleteFramebuffers(1, &fbo); glDeleteRenderbuffers(1, &rbo); destroyImage(display, eglImage);
+    eglDestroyContext(display, context); eglTerminate(display); close(fd);
+    vkDestroyImage(device, vkImage, nullptr); vkFreeMemory(device, memory, nullptr); vkDestroyDevice(device, nullptr); vkDestroyInstance(instance, nullptr);
+    return 0;
+}
diff --git a/tests/KGSLVulkanExportProbe.cpp b/tests/KGSLVulkanExportProbe.cpp
new file mode 100644
index 0000000..3fe13d2
--- /dev/null
+++ b/tests/KGSLVulkanExportProbe.cpp
@@ -0,0 +1,153 @@
+#include <vulkan/vulkan.h>
+
+#include <drm_fourcc.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <vector>
+
+#define VK_CHECK(call)                                                                                                                                        \
+    do {                                                                                                                                                      \
+        const VkResult result = (call);                                                                                                                       \
+        if (result != VK_SUCCESS) {                                                                                                                           \
+            std::fprintf(stderr, "%s failed: %d\n", #call, result);                                                                                         \
+            return 1;                                                                                                                                         \
+        }                                                                                                                                                     \
+    } while (0)
+
+int main() {
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "kgsl-vulkan-export-probe";
+    app.apiVersion       = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo instanceInfo{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    instanceInfo.pApplicationInfo = &app;
+    VkInstance instance = VK_NULL_HANDLE;
+    VK_CHECK(vkCreateInstance(&instanceInfo, nullptr, &instance));
+
+    uint32_t physicalCount = 0;
+    VK_CHECK(vkEnumeratePhysicalDevices(instance, &physicalCount, nullptr));
+    if (!physicalCount)
+        return 2;
+    std::vector<VkPhysicalDevice> physicals(physicalCount);
+    VK_CHECK(vkEnumeratePhysicalDevices(instance, &physicalCount, physicals.data()));
+    const VkPhysicalDevice physical = physicals[0];
+
+    uint32_t familyCount = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, nullptr);
+    std::vector<VkQueueFamilyProperties> families(familyCount);
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, families.data());
+    uint32_t family = UINT32_MAX;
+    for (uint32_t i = 0; i < familyCount; ++i) {
+        if (families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
+            family = i;
+            break;
+        }
+    }
+    if (family == UINT32_MAX)
+        return 3;
+
+    float priority = 1.F;
+    VkDeviceQueueCreateInfo queueInfo{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    queueInfo.queueFamilyIndex = family;
+    queueInfo.queueCount       = 1;
+    queueInfo.pQueuePriorities = &priority;
+    const char* extensions[]   = {VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME};
+    VkDeviceCreateInfo deviceInfo{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    deviceInfo.queueCreateInfoCount    = 1;
+    deviceInfo.pQueueCreateInfos       = &queueInfo;
+    deviceInfo.enabledExtensionCount   = 1;
+    deviceInfo.ppEnabledExtensionNames = extensions;
+    VkDevice device = VK_NULL_HANDLE;
+    VK_CHECK(vkCreateDevice(physical, &deviceInfo, nullptr, &device));
+
+    constexpr VkImageUsageFlags usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                                        VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    VkPhysicalDeviceExternalImageFormatInfo externalFormat{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO};
+    externalFormat.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkPhysicalDeviceImageFormatInfo2 formatInfo{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2};
+    formatInfo.pNext = &externalFormat;
+    formatInfo.format = VK_FORMAT_B8G8R8A8_UNORM;
+    formatInfo.type = VK_IMAGE_TYPE_2D;
+    formatInfo.tiling = VK_IMAGE_TILING_LINEAR;
+    formatInfo.usage = usage;
+    VkExternalImageFormatProperties externalProperties{VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES};
+    VkImageFormatProperties2 formatProperties{VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2};
+    formatProperties.pNext = &externalProperties;
+    VK_CHECK(vkGetPhysicalDeviceImageFormatProperties2(physical, &formatInfo, &formatProperties));
+    std::printf("external_features=0x%x compatible=0x%x\n", externalProperties.externalMemoryProperties.externalMemoryFeatures,
+                externalProperties.externalMemoryProperties.compatibleHandleTypes);
+
+    VkExternalMemoryImageCreateInfo externalImage{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+    externalImage.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkImageCreateInfo imageInfo{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    imageInfo.pNext       = &externalImage;
+    imageInfo.imageType   = VK_IMAGE_TYPE_2D;
+    imageInfo.format      = VK_FORMAT_B8G8R8A8_UNORM;
+    imageInfo.extent      = {1920, 1200, 1};
+    imageInfo.mipLevels   = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples     = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling      = VK_IMAGE_TILING_LINEAR;
+    imageInfo.usage       = usage;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImage image = VK_NULL_HANDLE;
+    VK_CHECK(vkCreateImage(device, &imageInfo, nullptr, &image));
+
+    VkMemoryRequirements requirements{};
+    vkGetImageMemoryRequirements(device, image, &requirements);
+    VkPhysicalDeviceMemoryProperties memories{};
+    vkGetPhysicalDeviceMemoryProperties(physical, &memories);
+    uint32_t memoryType = UINT32_MAX;
+    for (uint32_t i = 0; i < memories.memoryTypeCount; ++i) {
+        if ((requirements.memoryTypeBits & (1U << i)) && (memories.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+            memoryType = i;
+            break;
+        }
+    }
+    if (memoryType == UINT32_MAX) {
+        for (uint32_t i = 0; i < memories.memoryTypeCount; ++i) {
+            if (requirements.memoryTypeBits & (1U << i)) {
+                memoryType = i;
+                break;
+            }
+        }
+    }
+    if (memoryType == UINT32_MAX)
+        return 4;
+
+    VkMemoryDedicatedAllocateInfo dedicated{VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+    dedicated.image = image;
+    VkExportMemoryAllocateInfo exportInfo{VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+    exportInfo.pNext = &dedicated;
+    exportInfo.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocation.pNext = &exportInfo;
+    allocation.allocationSize = requirements.size;
+    allocation.memoryTypeIndex = memoryType;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VK_CHECK(vkAllocateMemory(device, &allocation, nullptr, &memory));
+    VK_CHECK(vkBindImageMemory(device, image, memory, 0));
+
+    VkImageSubresource subresource{VK_IMAGE_ASPECT_COLOR_BIT, 0, 0};
+    VkSubresourceLayout layout{};
+    vkGetImageSubresourceLayout(device, image, &subresource, &layout);
+    auto getMemoryFd = reinterpret_cast<PFN_vkGetMemoryFdKHR>(vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR"));
+    if (!getMemoryFd)
+        return 5;
+    VkMemoryGetFdInfoKHR fdInfo{VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR};
+    fdInfo.memory = memory;
+    fdInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    int fd = -1;
+    VK_CHECK(getMemoryFd(device, &fdInfo, &fd));
+    std::printf("drm=0x%x allocation=%llu offset=%llu size=%llu rowPitch=%llu fd=%d\n", DRM_FORMAT_XRGB8888,
+                static_cast<unsigned long long>(requirements.size), static_cast<unsigned long long>(layout.offset),
+                static_cast<unsigned long long>(layout.size), static_cast<unsigned long long>(layout.rowPitch), fd);
+
+    close(fd);
+    vkDestroyImage(device, image, nullptr);
+    vkFreeMemory(device, memory, nullptr);
+    vkDestroyDevice(device, nullptr);
+    vkDestroyInstance(instance, nullptr);
+    return 0;
+}
diff --git a/tests/Output.cpp b/tests/Output.cpp
new file mode 100644
index 0000000..3754fdf
--- /dev/null
+++ b/tests/Output.cpp
@@ -0,0 +1,62 @@
+#include <aquamarine/output/Output.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <hyprutils/memory/SharedPtr.hpp>
+#include "OutputTiming.hpp"
+#include "shared.hpp"
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+
+class CTestOutput : public IOutput {
+  public:
+    virtual bool commit() {
+        return false;
+    }
+
+    virtual bool test() {
+        return false;
+    }
+
+    virtual CSharedPointer<IBackendImplementation> getBackend() {
+        return nullptr;
+    }
+
+    virtual std::vector<SDRMFormat> getRenderFormats() {
+        return {};
+    }
+
+    virtual bool pendingPageFlip() {
+        return false;
+    }
+
+    virtual bool pendingIdleFrame() {
+        return false;
+    }
+};
+
+int main() {
+    int         ret = 0;
+    CTestOutput output;
+
+    EXPECT(output.hasCursorPlane(), false);
+    EXPECT(output.nextVBlank().has_value(), false);
+
+    using namespace std::chrono_literals;
+
+    const auto NEXT = OutputTiming::predictNextVBlank(100ns, 150ns, 100ns);
+    EXPECT(NEXT.has_value(), true);
+    EXPECT(NEXT->count(), 200);
+
+    EXPECT(OutputTiming::predictNextVBlank(100ns, 200ns, 100ns).has_value(), false);
+    EXPECT(OutputTiming::predictNextVBlank(201ns, 200ns, 100ns).has_value(), false);
+    EXPECT(OutputTiming::predictNextVBlank(100ns, 150ns, 0ns).has_value(), false);
+    EXPECT(OutputTiming::predictNextVBlank(std::chrono::nanoseconds::max() - 50ns, std::chrono::nanoseconds::max() - 25ns, 100ns).has_value(), false);
+
+    const auto STEADY_EPOCH = std::chrono::steady_clock::time_point{};
+    const auto CONVERTED    = OutputTiming::toSteadyClock(200ns, 150ns, STEADY_EPOCH + 100ns, STEADY_EPOCH + 110ns);
+    EXPECT(CONVERTED.has_value(), true);
+    EXPECT(CONVERTED->time_since_epoch().count(), 155);
+    EXPECT(OutputTiming::toSteadyClock(160ns, 150ns, STEADY_EPOCH + 100ns, STEADY_EPOCH + 120ns).has_value(), false);
+
+    return ret;
+}
