+Aquamarine::CVulkanAllocator::CVulkanAllocator(CWeakPointer<CBackend> backend_) : backend(backend_) {}
+
+bool Aquamarine::CVulkanAllocator::init() {
+    VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    app.pApplicationName = "Aquamarine Android DMA-BUF allocator";
+    app.apiVersion       = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo instanceInfo{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    instanceInfo.pApplicationInfo = &app;
+    VkResult result = vkCreateInstance(&instanceInfo, nullptr, &instance);
+    if (result != VK_SUCCESS) {
+        backend->log(AQ_LOG_ERROR, std::format("Vulkan allocator: vkCreateInstance failed: {}", static_cast<int>(result)));
+        return false;
+    }
+
+    uint32_t physicalCount = 0;
+    result = vkEnumeratePhysicalDevices(instance, &physicalCount, nullptr);
+    if (result != VK_SUCCESS || !physicalCount) {
+        backend->log(AQ_LOG_ERROR, "Vulkan allocator: no physical device");
+        return false;
+    }
+    std::vector<VkPhysicalDevice> physicals(physicalCount);
+    result   = vkEnumeratePhysicalDevices(instance, &physicalCount, physicals.data());
+    physical = result == VK_SUCCESS ? physicals[0] : VK_NULL_HANDLE;
+    if (!physical)
+        return false;
+
+    uint32_t familyCount = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, nullptr);
+    std::vector<VkQueueFamilyProperties> families(familyCount);
+    vkGetPhysicalDeviceQueueFamilyProperties(physical, &familyCount, families.data());
+    for (uint32_t i = 0; i < familyCount; ++i) {
+        if (families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
+            queueFamily = i;
+            break;
+        }
+    }
+    if (queueFamily == UINT32_MAX) {
+        backend->log(AQ_LOG_ERROR, "Vulkan allocator: no graphics queue family");
+        return false;
+    }
+
+    VkPhysicalDeviceExternalImageFormatInfo externalFormat{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO};
+    externalFormat.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkPhysicalDeviceImageFormatInfo2 formatInfo{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2};
+    formatInfo.pNext  = &externalFormat;
+    formatInfo.format = VK_FORMAT_B8G8R8A8_UNORM;
+    formatInfo.type   = VK_IMAGE_TYPE_2D;
+    formatInfo.tiling = VK_IMAGE_TILING_LINEAR;
+    formatInfo.usage  = IMAGE_USAGE;
+    VkExternalImageFormatProperties externalProperties{VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES};
+    VkImageFormatProperties2 properties{VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2};
+    properties.pNext = &externalProperties;
+    result = vkGetPhysicalDeviceImageFormatProperties2(physical, &formatInfo, &properties);
+    if (result != VK_SUCCESS || !(externalProperties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT)) {
+        backend->log(AQ_LOG_ERROR, "Vulkan allocator: Turnip cannot export a linear BGRA color image");
+        return false;
+    }
+
+    float priority = 1.F;
+    VkDeviceQueueCreateInfo queueInfo{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    queueInfo.queueFamilyIndex = queueFamily;
+    queueInfo.queueCount       = 1;
+    queueInfo.pQueuePriorities = &priority;
+    const char* extensions[]   = {VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME};
+    VkDeviceCreateInfo deviceInfo{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    deviceInfo.queueCreateInfoCount    = 1;
+    deviceInfo.pQueueCreateInfos       = &queueInfo;
+    deviceInfo.enabledExtensionCount   = 1;
+    deviceInfo.ppEnabledExtensionNames = extensions;
+    result = vkCreateDevice(physical, &deviceInfo, nullptr, &device);
+    if (result != VK_SUCCESS) {
+        backend->log(AQ_LOG_ERROR, std::format("Vulkan allocator: vkCreateDevice failed: {}", static_cast<int>(result)));
+        return false;
+    }
+
+    getMemoryFd = reinterpret_cast<PFN_vkGetMemoryFdKHR>(vkGetDeviceProcAddr(device, "vkGetMemoryFdKHR"));
+    if (!getMemoryFd) {
+        backend->log(AQ_LOG_ERROR, "Vulkan allocator: vkGetMemoryFdKHR is unavailable");
+        return false;
+    }
+
+    VkPhysicalDeviceProperties deviceProperties{};
+    vkGetPhysicalDeviceProperties(physical, &deviceProperties);
+    backend->log(AQ_LOG_DEBUG, std::format("Vulkan allocator: using {}", deviceProperties.deviceName));
+    return true;
+}
+
+Aquamarine::CVulkanAllocator::~CVulkanAllocator() {
+    if (device) {
+        vkDeviceWaitIdle(device);
+        vkDestroyDevice(device, nullptr);
+    }
+    if (instance)
+        vkDestroyInstance(instance, nullptr);
+}
+
+SP<CVulkanAllocator> Aquamarine::CVulkanAllocator::create(CWeakPointer<CBackend> backend_) {
+    auto allocator = SP<CVulkanAllocator>(new CVulkanAllocator(backend_));
+    if (!allocator->init())
+        return nullptr;
+    allocator->self = allocator;
+    return allocator;
+}
+
+SP<IBuffer> Aquamarine::CVulkanAllocator::acquire(const SAllocatorBufferParams& params, SP<CSwapchain> swapchain_) {
+    auto buffer = SP<IBuffer>(new CVulkanBuffer(params, self));
+    return buffer->good() ? buffer : nullptr;
+}
+
+SP<CBackend> Aquamarine::CVulkanAllocator::getBackend() {
+    return backend.lock();
+}
+
+int Aquamarine::CVulkanAllocator::drmFD() {
+    return -1;
+}
+
+eAllocatorType Aquamarine::CVulkanAllocator::type() {
+    return AQ_ALLOCATOR_TYPE_VULKAN;
+}
