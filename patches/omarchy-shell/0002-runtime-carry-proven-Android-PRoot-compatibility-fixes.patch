diff --git a/bin/omarchy-menu-keybindings b/bin/omarchy-menu-keybindings
index 767b5dac..ebbbe20c 100755
--- a/bin/omarchy-menu-keybindings
+++ b/bin/omarchy-menu-keybindings
@@ -2,6 +2,60 @@
 
 # omarchy:summary=Display Hyprland keybindings defined in your configuration using an interactive search menu.
 
+# Some Samsung keyboards emit several Meta-key activations for one physical
+# chord. Serialize PRoot invocations so one chord cannot open multiple menus.
+# If Android's child-process restriction is still enabled, use the cached
+# low-process viewer; otherwise continue into Omarchy's full interactive menu.
+if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
+  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-menu-keybindings.lock"
+  flock -n 9 || exit 0
+
+  if [[ ${OMARCHY_UNLIMITED_PROCS:-0} != 1 ]]; then
+  shopt -s nullglob
+  cache_files=("${XDG_CACHE_HOME:-$HOME/.cache}/omarchy"/keybindings-*.records)
+  shopt -u nullglob
+
+  labels=()
+  if [[ -f ${cache_files[0]:-} ]]; then
+    while IFS=$'\t' read -r label _; do
+      [[ -n $label ]] && labels+=("$label")
+    done <"${cache_files[0]}"
+  fi
+
+  # Retain a useful emergency set if the cache has not been populated yet.
+  if (( ${#labels[@]} == 0 )); then
+    labels=(
+      "SUPER + K                           → Keybindings"
+      "SUPER + SPACE                       → Omarchy menu"
+      "SUPER + RETURN                      → Terminal"
+      "SUPER SHIFT + RETURN                → Browser"
+      "SUPER SHIFT + F                     → File manager"
+      "SUPER + ESCAPE                      → System menu"
+      "SUPER SHIFT CTRL + SPACE            → Theme menu"
+      "SUPER + F                           → Full screen"
+      "SUPER + Q                           → Close window"
+    )
+  fi
+
+  payload='{"mode":"select","prompt":"Keybindings","options":['
+  separator=
+  for label in "${labels[@]}"; do
+    label=${label//\\/\\\\}
+    label=${label//\"/\\\"}
+    label=${label//$'\n'/\\n}
+    label=${label//$'\r'/\\r}
+    label=${label//$'\t'/\\t}
+    payload+="${separator}\"${label}\""
+    separator=,
+  done
+  payload+='],"width":800,"maxHeight":500}'
+
+  qs ipc -n -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell" call -- shell summon omarchy.menu "$payload"
+  sleep 2
+  exit 0
+  fi
+fi
+
 # Hyprland's Lua config provider currently reports Lua binds as dispatcher
 # __lua in `hyprctl binds`. Keep a lightweight source-derived cache so the
 # menu can still show and dispatch those bindings.
@@ -69,19 +123,14 @@ parse_keycodes() {
 # Supplement `hyprctl binds` for Lua-only binds that Hyprland currently
 # reports as dispatcher __lua and without their original key for code: binds.
 build_lua_bind_cache() {
-  local modmask description key dispatcher arg cache_key
+  local modmask description key dispatcher arg cache_key lua_bind_records
 
   omarchy-cmd-present lua || return 0
 
-  while IFS=$'\t' read -r modmask description key dispatcher arg; do
-    [[ -z $modmask || -z $description || -z $key ]] && continue
-
-    LUA_BIND_KEY_MAP["$modmask,$description"]="$key"
-    cache_key="$modmask,$description,$key"
-    LUA_BIND_DISPATCHER_MAP["$cache_key"]="$dispatcher"
-    LUA_BIND_ARG_MAP["$cache_key"]="$arg"
-  done < <(
-    lua <<'LUA'
+  # PRoot cannot reliably reopen Bash process-substitution descriptors through
+  # /dev/fd. Capture Lua's small text result first, then parse it from a here
+  # string so dispatcher metadata is not silently discarded.
+  lua_bind_records=$(lua <<'LUA'
 local modifiers = { SHIFT = 1, CTRL = 4, CONTROL = 4, ALT = 8, SUPER = 64 }
 
 local function split_keys(keys)
@@ -220,6 +269,9 @@ hl = setmetatable({
   get_config = function()
     return nil
   end,
+  get_active_monitor = function()
+    return nil
+  end,
 }, {
   __index = function()
     return noop
@@ -238,6 +290,15 @@ if file then
 end
 LUA
   )
+
+  while IFS=$'\t' read -r modmask description key dispatcher arg; do
+    [[ -z $modmask || -z $description || -z $key ]] && continue
+
+    LUA_BIND_KEY_MAP["$modmask,$description"]="$key"
+    cache_key="$modmask,$description,$key"
+    LUA_BIND_DISPATCHER_MAP["$cache_key"]="$dispatcher"
+    LUA_BIND_ARG_MAP["$cache_key"]="$arg"
+  done <<<"$lua_bind_records"
 }
 
 modmask_to_text() {
@@ -530,7 +591,7 @@ output_binding_records_uncached() {
 
 keybindings_cache_key() {
   {
-    printf 'v13\n'
+    printf 'v14\n'
     hyprctl devices 2>/dev/null | grep -F 'active keymap:'
