diff --git a/bin/omarchy-launch-browser b/bin/omarchy-launch-browser
index 044b220d..a7f7b58b 100755
--- a/bin/omarchy-launch-browser
+++ b/bin/omarchy-launch-browser
@@ -1,8 +1,32 @@
 #!/bin/bash
 
+if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
+  export PULSE_SERVER=tcp:127.0.0.1:4715
+fi
+
 # omarchy:summary=Launch the default browser as determined by xdg-settings.
 # omarchy:args=[url]
 
+if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
+  args=()
+  for argument in "$@"; do
+    if [[ $argument == "--private" ]]; then
+      args+=("--incognito")
+    else
+      args+=("$argument")
+    fi
+  done
+
+  # There is no user systemd/uwsm or usable Chromium namespace sandbox in the
+  # isolated PRoot session. Launch the native ARM64 browser directly, while
+  # otherwise retaining Chromium's normal multi-process architecture.
+  exec chromium \
+    --no-sandbox \
+    --disable-dev-shm-usage \
+    --password-store=basic \
+    "${args[@]}"
+fi
+
 default_browser=$(env -u BROWSER xdg-settings get default-web-browser)
 if [[ -z $default_browser ]]; then
   default_browser=$(xdg-mime query default x-scheme-handler/https)
diff --git a/bin/omarchy-launch-shell b/bin/omarchy-launch-shell
index c183eb0b..ff7c1b65 100755
--- a/bin/omarchy-launch-shell
+++ b/bin/omarchy-launch-shell
@@ -14,9 +14,74 @@
 # A package upgrade rewriting $OMARCHY_PATH/shell would otherwise reload it
 # against a half-written tree, and that failed reload leaves a second engine
 # generation behind that turns the next restart's IPC kill into a crash.
+prepare_proot_plugin_index() {
+  local output="$XDG_RUNTIME_DIR/omarchy-plugin-scan.txt"
+  local temporary="${output}.new"
+  local manifest sub line
+  local plugin_root="$OMARCHY_PATH/shell/plugins"
+  local -a manifests
+
+  : > "$temporary"
+  shopt -s nullglob
+  manifests=(
+    "$plugin_root"/*/manifest.json
+    "$plugin_root"/*/*/manifest.json
+    "$plugin_root"/*/*/*.manifest.json
+  )
+
+  for manifest in "${manifests[@]}"; do
+    if [[ ${manifest##*/} == manifest.json ]]; then
+      sub=${manifest%/manifest.json}
+    else
+      sub=${manifest%/*}
+    fi
+    printf '===firstparty::%s===\n' "$sub" >> "$temporary"
+    while IFS= read -r line || [[ -n $line ]]; do
+      printf '%s\n' "$line" >> "$temporary"
+    done < "$manifest"
+    printf '\n=== EOM ===\n' >> "$temporary"
+  done
+
+  for sub in "$HOME/.config/omarchy/plugins"/*/; do
+    [[ -f "$sub/manifest.json" ]] || continue
+    printf '===thirdparty::%s===\n' "${sub%/}" >> "$temporary"
+    while IFS= read -r line || [[ -n $line ]]; do
+      printf '%s\n' "$line" >> "$temporary"
+    done < "$sub/manifest.json"
+    printf '\n=== EOM ===\n' >> "$temporary"
+  done
+
+  mv -f -- "$temporary" "$output"
+}
+
+if [[ $(uname -r) == *PRoot* ]]; then
+  export OMARCHY_PROOT=1
+  prepare_proot_plugin_index
+fi
+
 run_shell() {
-  QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
-    systemd-cat -t omarchy-shell -- quickshell -n -p "$OMARCHY_PATH/shell" &
+  if [[ -S /run/systemd/journal/stdout ]]; then
+    QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
+      systemd-cat -t omarchy-shell -- quickshell -n -p "$OMARCHY_PATH/shell" &
+  else
+    # PRoot has no systemd journal. Keep the real Omarchy shell and supervision;
+    # only bypass the journal transport that cannot exist in this environment.
+    if [[ ${OMARCHY_GPU_MODE:-virgl} == kgsl ]]; then
+      # Qt Quick's direct KGSL buffers can become permanently transparent
+      # after the outer Termux:X11 Android surface reconnects. Use Qt's
+      # reliable SHM renderer for the shell only; Hyprland, Weston, and apps
+      # remain GPU accelerated.
+      NO_AT_BRIDGE=1 QT_ACCESSIBILITY=0 QT_QPA_PLATFORMTHEME= \
+        QT_QUICK_BACKEND=software QSG_RENDER_LOOP=basic \
+        QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
+        quickshell -n -p "$OMARCHY_PATH/shell" &
+    else
+      NO_AT_BRIDGE=1 QT_ACCESSIBILITY=0 QT_QPA_PLATFORMTHEME= \
+        QT_QUICK_BACKEND=software QSG_RENDER_LOOP=basic \
+        QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
+        quickshell -n -p "$OMARCHY_PATH/shell" &
+    fi
+  fi
   shell_pid=$!
 
   local status
