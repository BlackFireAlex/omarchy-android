#!/usr/bin/bash

set -euo pipefail

if ! command -v voxtype >/dev/null 2>&1; then
  printf 'The checksum-verified ARM64 Voxtype runtime is missing.\n' >&2
  exit 1
fi

if command -v gum >/dev/null 2>&1; then
  gum confirm 'Download the base English dictation model (~150 MB)?' || exit 0
fi

mkdir -p "$HOME/.config/voxtype"
if [[ ! -f "$HOME/.config/voxtype/config.toml" ]]; then
  install -m 0644 /usr/share/omarchy/default/voxtype/config.toml \
    "$HOME/.config/voxtype/config.toml"
fi

voxtype setup --download --model base.en --activate --no-post-install
voxtype config set hotkey.enabled false
voxtype config set whisper.on_demand_loading true
omarchy-voxtype-daemon start

if command -v omarchy-notification-send >/dev/null 2>&1; then
  omarchy-notification-send \
    'Voxtype Dictation Ready' \
    'Hold F9 to dictate, or toggle with Super + Ctrl + X.' \
    -t 10000 || true
fi
