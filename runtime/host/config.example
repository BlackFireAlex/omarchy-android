# Generated by the installer as config/runtime.conf.
# Reference template for every host knob read by runtime/host/omarchy-android-start.
OMARCHY_CONTAINER=omarchy-android
OMARCHY_MESA_PREFIX=/opt/omarchy-android/mesa/root/usr
OMARCHY_TURNIP_ICD=/opt/omarchy-android/mesa/freedreno_icd.json
OMARCHY_AQUAMARINE_STAGE=/opt/omarchy-android/aquamarine
OMARCHY_HYPRLAND_STAGE=/opt/omarchy-android/hyprland
OMARCHY_GPU_MODE=kgsl
OMARCHY_COMPOSITOR_GL_DRIVER=kgsl

# Display + input tuning.
#
# The device-presets module (runtime/host/device-presets.sh) is sourced before
# this file and resolves the 'auto' sentinels below to a per-device preset on
# start:
#   * VITURE Pro Neckband     -> 1920x1080 @ 90 Hz (90000 mHz), scale 1
#   * VITURE Luma Ultra       -> 1920x1200 @ 120 Hz (120000 mHz), scale 1
#                                (+ fractional monitor scale 1.25 for reading comfort)
#   * any other Android phone -> stock dynamic 1448x1920 / 120 Hz / scale 2
# Set a concrete WIDTHxHEIGHT / millihz (mHz) / scale here to override detection.
OMARCHY_DISPLAY_RESOLUTION=auto
OMARCHY_REFRESH_MHZ=auto
OMARCHY_SCALE=auto

# BT-safe XKB autorepeat. The outer X11 repeat layer is disabled so Hyprland
# owns repeat timing (Wayland-side equivalent lives in hypr/input.lua). These
# are the preset for the X11 helper when a physical BT keyboard bypasses the
# Wayland repeat path:
#   omarchy-x11-keyboard on "$OMARCHY_X11_REPEAT_DELAY" "$OMARCHY_X11_REPEAT_INTERVAL"
OMARCHY_X11_REPEAT_DELAY=700
OMARCHY_X11_REPEAT_INTERVAL=65
# 1 = BT mouse held in the left hand (honored by hypr/input.lua + hypr/input/pointer.lua).
OMARCHY_POINTER_LEFT_HANDED=0

OMARCHY_KEYBOARD_LAYOUT=auto
OMARCHY_SHARE=none
OMARCHY_AUDIO=1
OMARCHY_PROCESS_LIMIT=28
